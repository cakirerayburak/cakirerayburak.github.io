{
  "name": "Precision Document",
  "usage": "Design system for cakirerayburak.github.io. Engineering-document aesthetic with two themes: DARK is the default (root tokens), LIGHT via html[data-theme=light] (user toggle, persisted). Sharp containers (radius 0), 2px radius on interactive controls only. Type: Archivo variable (display + body), IBM Plex Mono (metadata). Print always uses the light palette.",
  "colors": [
    { "token": "paper", "value": "#F5F3EE", "use": "page background" },
    { "token": "paper-raised", "value": "#FCFBF8", "use": "raised surface" },
