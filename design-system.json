{
  "name": "Precision Document",
  "usage": "Design system for cakirerayburak.github.io. Light engineering-document surface, graphite ink, one redline accent (vermilion). Sharp containers (radius 0), 2px radius on interactive controls only. Type: Archivo variable (display + body), IBM Plex Mono (metadata).",
  "colors": [
    { "token": "paper", "value": "#F6F5F1", "use": "page background" },
    { "token": "paper-raised", "value": "#FDFCFA", "use": "raised surface" },
    { "token": "ink", "value": "#1B1E22", "use": "primary text" },
    { "token": "ink-2", "value": "#43484F", "use": "secondary text" },
    { "token": "ink-3", "value": "#5D636C", "use": "metadata text" },
    { "token": "hairline", "value": "#DBD7CE", "use": "rules and separators" },
    { "token": "hairline-strong", "value": "#C7C2B7", "use": "stronger rules, button borders" },
    { "token": "accent", "value": "#BC3E12", "use": "redline mark, fills, primary button hover" },
    { "token": "accent-text", "value": "#A9370D", "use": "accent as text/link color (AA on paper)" },
    { "token": "accent-bright", "value": "#E06B3A", "use": "accent on dark band" },
    { "token": "band-bg", "value": "#15181B", "use": "contact/footer band background" },
    { "token": "band-ink", "value": "#EDEBE5", "use": "text on dark band" },
    { "token": "band-ink-2", "value": "#A9AFB7", "use": "secondary text on dark band" },
    { "token": "band-hairline", "value": "#353B42", "use": "rules on dark band" },
    { "token": "white", "value": "#FFFFFF", "use": "text on accent fills, selection" }
  ],
  "fonts": [
    { "token": "sans", "value": "Archivo, 'Helvetica Neue', Arial, sans-serif", "use": "display and body" },
    { "token": "mono", "value": "'IBM Plex Mono', 'Courier New', monospace", "use": "metadata, dates, stacks" }
  ],
  "spacing": [
    { "token": "s1", "value": "0.25rem", "use": "4" },
    { "token": "s2", "value": "0.5rem", "use": "8" },
    { "token": "s3", "value": "0.75rem", "use": "12" },
    { "token": "s4", "value": "1rem", "use": "16" },
    { "token": "s5", "value": "1.5rem", "use": "24" },
    { "token": "s6", "value": "2rem", "use": "32" },
    { "token": "s7", "value": "3rem", "use": "48" },
    { "token": "s8", "value": "4rem", "use": "64" }
  ],
  "radii": [
    { "token": "control", "value": "2px", "use": "buttons, lang toggle" }
  ]
