    { "token": "ink-3", "value": "#5C6470", "use": "metadata text" },
    { "token": "hairline", "value": "#DBD7CD", "use": "rules and separators" },
    { "token": "hairline-strong", "value": "#C9C3B8", "use": "stronger rules, button borders" },
    { "token": "accent", "value": "#B23A10", "use": "redline mark, fills, primary button hover" },
    { "token": "accent-text", "value": "#9E3208", "use": "accent as text/link color (AA on paper)" },
    { "token": "accent-bright", "value": "#EC744A", "use": "accent on dark band" },
    { "token": "band-bg", "value": "#12151B", "use": "contact/footer band background" },
    { "token": "band-ink", "value": "#ECEDEF", "use": "text on dark band" },
    { "token": "band-ink-2", "value": "#9AA1AD", "use": "secondary text on dark band" },
    { "token": "band-hairline", "value": "#303743", "use": "rules on dark band" },
    { "token": "white", "value": "#FFFFFF", "use": "text on accent fills, selection" },
    { "token": "dark/paper", "value": "#101318", "use": "default dark page background" },
    { "token": "dark/paper-raised", "value": "#151922", "use": "dark raised surface" },
    { "token": "dark/ink", "value": "#ECEDEF", "use": "dark theme primary text" },
    { "token": "dark/ink-2", "value": "#A8B0BC", "use": "dark theme secondary text" },
    { "token": "dark/ink-3", "value": "#7E8694", "use": "dark theme metadata text" },
    { "token": "dark/hairline", "value": "#262C37", "use": "dark theme rules" },
    { "token": "dark/hairline-strong", "value": "#343B49", "use": "dark theme strong rules and borders" },
    { "token": "dark/accent", "value": "#C9501F", "use": "dark theme accent fills/marks" },
    { "token": "dark/accent-text", "value": "#EC744A", "use": "dark theme accent as text (AA on dark paper)" },
    { "token": "dark/band-bg", "value": "#1A2029", "use": "contact band on dark theme (elevated)" },
    { "token": "dark/band-ink", "value": "#E8EAEE", "use": "dark theme band text" },
    { "token": "dark/band-ink-2", "value": "#969DAB", "use": "contact band secondary text on dark theme" },
    { "token": "dark/band-hairline", "value": "#2C3340", "use": "contact band rules on dark theme" }
